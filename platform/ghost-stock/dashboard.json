{
 "uid": "ghost-stock",
 "title": "Ghost Stock · game page",
 "schemaVersion": 39,
 "version": 1,
 "tags": [
  "ghost-stock",
  "slo",
  "probe"
 ],
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "refresh": "1m",
 "description": "https://mierai.github.io/ghost-stock/ probed every 60s from winpc (home connection, Japan) by blackbox_exporter. SLO: platform/slo/external/ghost-stock.yaml.",
 "links": [
  {
   "title": "Open the game",
   "type": "link",
   "url": "https://mierai.github.io/ghost-stock/",
   "targetBlank": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Prometheus"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Now",
   "description": "Last probe from winpc (every 60s): page answered 2xx over HTTPS within 5s.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max(probe_success{slo_probe=\"ghost-stock-pages-external-probe\"})",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Down",
         "color": "red"
        },
        "1": {
         "text": "Up",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Availability · 24h",
   "description": "Share of good probes in the last 24 hours.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "avg(avg_over_time(probe_success{slo_probe=\"ghost-stock-pages-external-probe\"}[24h]))",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.99
       },
       {
        "color": "green",
        "value": 0.999
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Availability · 28d",
   "description": "Share of good probes over the SLO window (28 days). Objective 99%.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "avg(avg_over_time(probe_success{slo_probe=\"ghost-stock-pages-external-probe\"}[28d]))",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.99
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Error budget left · 28d",
   "description": "Objective 99% allows 1% bad probes (~6.7 h per 28 days). 100% = untouched, ≤0 = spent.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "1 - (1 - avg(avg_over_time(probe_success{slo_probe=\"ghost-stock-pages-external-probe\"}[28d]))) / (1 - 0.99)",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Load time · median 1h",
   "description": "Median full probe time (DNS + connect + TLS + response) from winpc, last hour.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max(quantile_over_time(0.5, probe_duration_seconds{slo_probe=\"ghost-stock-pages-external-probe\"}[1h]))",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 3
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "TLS certificate expires in",
   "description": "Days until the HTTPS certificate GitHub serves expires (GitHub renews it).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(min(probe_ssl_earliest_cert_expiry{slo_probe=\"ghost-stock-pages-external-probe\"}) - time()) / 86400",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "d",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 7
       },
       {
        "color": "green",
        "value": 21
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Availability (hourly)",
   "description": "Share of good probes per hour. Dashed line: the 99% objective.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "avg(avg_over_time(probe_success{slo_probe=\"ghost-stock-pages-external-probe\"}[1h]))",
     "legendFormat": "availability"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "decimals": 1,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 0.99
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": false
    },
    "tooltip": {
     "mode": "single"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Load time by phase",
   "description": "Where the time goes on each probe: DNS resolve, TCP connect, TLS handshake, waiting for the server, transfer. Stacked = total.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "avg by (phase) (avg_over_time(probe_http_duration_seconds{slo_probe=\"ghost-stock-pages-external-probe\"}[$__rate_interval]))",
     "legendFormat": "{{phase}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Failed probes per hour",
   "description": "Probes that did not get a 2xx within 5s, counted per hour (60 probes per hour). Any bar = players may have seen \"site can't be reached\".",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(count_over_time(probe_success{slo_probe=\"ghost-stock-pages-external-probe\"}[1h]) - sum_over_time(probe_success{slo_probe=\"ghost-stock-pages-external-probe\"}[1h]))",
     "legendFormat": "failed",
     "interval": "1h"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     },
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": false
    },
    "tooltip": {
     "mode": "single"
    }
   }
  }
 ]
}